{
  "name": "editorial",
  "label": "Editorial: magazine serif hero words, muted palette, moody grade.",
  "colors": {
    "accent": "#C8553D", "win": "#D9A441", "dark": "#1F2A30", "dark2": "#3C4F5A",
    "ink": "#0B0D0F", "light": "#F7F3EE", "light_dim": "#E9E2D8"
  },
  "fonts": {
    "caption": "Manrope", "caption_file": "Manrope-Regular.ttf",
    "caption_bold": "Manrope ExtraBold", "caption_bold_file": "Manrope-ExtraBold.ttf",
    "hero": "Fraunces Bold", "hero_italic": true, "hero_file": "Fraunces-BoldItalic.ttf",
    "title": "Fraunces Bold", "title_file": "Fraunces-Bold.ttf",
    "annotation": "Caveat Brush", "annotation_file": "CaveatBrush-Regular.ttf"
  },
  "captions": {
    "mode": "editorial_split", "zone": "upper", "size": 54, "hero_scale": 2.1,
    "max_words": 5, "text_color": "light", "hero_color": "light", "number_color": "win",
    "shadow": true, "pop": false, "case": "normal"
  },
  "cut": {
    "max_pause": 0.35, "keep_pause": 0.12, "min_segment": 0.25, "speed": 1.0,
    "jump_cut_punch": true, "punch_scale": 1.15,
    "fillers": ["um", "uh", "uhm", "erm", "hmm", "mm", "mhm"],
    "cut_stutters": true
  },
  "grade": { "look": "cinematic", "grain": 7, "vignette": 0.40, "denoise": true },
  "sound": {
    "sfx": "light", "sfx_every": [9, 12], "sfx_db_under_voice": 16,
    "banned": ["whoosh", "swish"], "music_db_under_voice": 18, "voice_lufs": -14
  },
  "end_card": { "enabled": false, "duration": 1.5, "line1": "", "line2": "", "bg": "ink", "fg": "light", "sfx": "projector-click" },
  "cta": { "style": "spread", "template": "Comment {keyword}", "seconds": 2.5, "bg": "accent", "fg": "light" },
  "rules": { "all_caps": false, "emojis": false, "banned_words": [] }
}
